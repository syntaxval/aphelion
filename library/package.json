{
  "name": "@syntaxval/aphelion",
  "version": "1.0.0",
  "description": "Zero-polyfill, Uint8Array-first Stellar HD account & keypair generation library (BIP39, SLIP-0010, SEP-0005, SEP-0023).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntaxval/aphelion.git"
  },
  "keywords": [
    "stellar",
    "hd-wallet",
    "bip39",
    "slip-0010",
    "sep-0005",
    "sep-0023",
    "ed25519",
    "paper-wallet",
    "cold-storage"
  ],
  "author": "syntaxval",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@scure/bip39": "^1.5.4"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
